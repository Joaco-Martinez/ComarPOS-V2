// Liquidacion de IVA mensual (paso siguiente al Libro IVA Digital, RG 4597):
// debito fiscal (IVA de Ventas) menos credito fiscal (IVA liquidado +
// percepciones de IVA sufridas en Compras) mas el arrastre de saldo a favor
// del periodo anterior = saldo tecnico del periodo. Ver
// services/libroIvaDigital/liquidacion.service.ts. Un registro por
// tenant+year+month; se recalcula libremente mientras status=BORRADOR (no
// se persiste hasta el primer calculo o cierre) y queda congelado al
// cerrarlo (status=CERRADO) para no correr el piso si despues se cargan/
// editan ventas o compras de ese mes con fecha retroactiva. Reabrirlo
// (volver a BORRADOR) es una accion explicita aparte, no implicita al
// recalcular.
model VatSettlement {
  id                   String              @id @default(uuid())
  tenantId             String?
  tenant               Tenant?             @relation(fields: [tenantId], references: [id])
  year                 Int
  month                Int
  // Suma de importeIva de las facturas de Ventas del periodo.
  debitoFiscal         Float               @default(0)
  // Suma de importeIvaLiquidado + percepcionIva (IVA sufrido) de las
  // compras del periodo -- ver liquidacion.service.ts para el detalle de
  // por que no se suman las otras percepciones (IIBB, municipales, etc: no
  // son IVA, no restan credito fiscal de IVA).
  creditoFiscal        Float               @default(0)
  // Saldo a favor arrastrado del periodo anterior (CERRADO), 0 si el
  // anterior dio a pagar o no hay periodo anterior.
  saldoTecnicoAnterior Float               @default(0)
  // debitoFiscal - creditoFiscal - saldoTecnicoAnterior. Positivo = a
  // pagar; negativo (o cero) = a favor, magnitud = lo que se arrastra al
  // periodo siguiente.
  saldoTecnico         Float               @default(0)
  resultado            VatSettlementResult
  status               VatSettlementStatus @default(BORRADOR)
  closedAt             DateTime?
  closedByUserId       String?
  closedByUser         User?               @relation(fields: [closedByUserId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@index([status])
}

model Sale {
  id                      String            @id @default(uuid())
  tenantId                String?
  tenant                  Tenant?           @relation(fields: [tenantId], references: [id])
  userId                  String?
  clientId                String?
  gmailSend               String?
  subtotal                Float             @default(0)
  total                   Float             @default(0)
  discountType            DiscountType?
  discountValue           Float?
  // Lista de precios usada para resolver el precio de los items (si es null,
  // se usa el mecanismo de precio/mayorista de siempre - ver
  // sale.pricing.ts#resolveUnitPrice). Se precarga con Client.priceListId al
  // armar una cotizacion, pero se puede overridear por venta.
  priceListId             String?
  priceList               PriceList?        @relation(fields: [priceListId], references: [id])
  // Descuentos multiples (mecanismo nuevo, aditivo, usado por la pantalla de
  // Cotizaciones - ver sale.discounts.ts). El descuento unico de arriba
  // (discountType/discountValue) sigue siendo el que usa el POS normal, no
  // se pisan entre si: solo uno de los dos mecanismos se usa por venta.
  discountsAccumulate     Boolean           @default(false)
  discounts               SaleDiscount[]
  isInvoiced              Boolean           @default(false)
  isNoteCredit            Boolean           @default(false)
  invoiceStatus           InvoiceStatus     @default(NONE)
  afipLastError           String?
  nextRetryAt             DateTime?
  retryCount              Int               @default(0)
  afipPayloadJson         Json?
  paymentMethod           PaymentMethod
  receiptType             ReceiptType
  status                  SaleStatus        @default(PENDING)
  isAccountSale           Boolean           @default(false)
  accountDebtAmount       Float             @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  pdfUrl                  String?
  stockLocation           Location          @default(LOCAL)
  // Reemplaza stockLocation (enum Location fijo) - de que ubicacion se
  // descuenta el stock de esta venta. Distinto de businessLocationId (esa
  // es metadata de en que sucursal se hizo la venta, no se toca). Ver doc
  // de migracion "ubicaciones de stock dinamicas". Nullable en la etapa
  // aditiva, pasa a requerido una vez migrado el codigo que la escribe.
  stockLocationId         String?
  stockLocationRef        BusinessLocation? @relation("SaleStockLocation", fields: [stockLocationId], references: [id])
  quotationExpiredAt      DateTime?
  quotationExpiresAt      DateTime?
  quotationPdfUrl         String?
  grossProfit             Float             @default(0)
  businessLocationId      String?
  declaredValue           Float?
  deliveryAddressSnapshot String?
  deliveryCost            Float             @default(0)
  deliveryDistanceKm      Float?
  deliveryMethod          DeliveryMethod    @default(PICKUP)
  deliveryStatus          DeliveryStatus    @default(NONE)
  packagesCount           Int?
  transportCuit           String?
  transportName           String?
  deliveryPricePerKm      Float?
  // devoluciones (doc: Sale con status=CANCELLED se usa como devolucion,
  // no hay modelo Return dedicado - este campo guarda el motivo/notas)
  returnReason            String?
  // promotion
  promotionId             String?
  promotionDiscount       Float?
  promotion               Promotion?        @relation(fields: [promotionId], references: [id])
  accountMovements        AccountMovement[]
  invoice                 Invoice?
  invoiceAfip             InvoiceAfip?
  remitos                 Remito[]
  businessLocation        BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  client                  Client?           @relation(fields: [clientId], references: [id])
  user                    User?             @relation(fields: [userId], references: [id])
  items                   SaleItem[]
  payments                SalePayment[]
  returns                 Return[]
  repairOrder             RepairOrder?
  reservation             Reservation?
  order                   Order?

  @@index([quotationExpiresAt])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([stockLocationId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([invoiceStatus, nextRetryAt])
  @@index([tenantId])
  @@index([promotionId])
}

// Devolucion de una venta ya completada: modelo propio (antes se reutilizaba
// Sale con status=CANCELLED sin registro dedicado, ver doc de auditoria).
// La venta sigue cancelandose (revierte stock/deuda via sale.lifecycle), esto
// ademas guarda el detalle propio de la devolucion (motivo, items, reembolso).
model Return {
  id           String         @id @default(uuid())
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  saleId       String
  sale         Sale           @relation(fields: [saleId], references: [id])
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  total        Float
  // Desglose de como se salda la diferencia entre lo devuelto y lo
  // entregado a cambio (ver return.service.ts#processReturn). "total"
  // sigue siendo el valor de lo devuelto (ReturnItem direction RETURNED),
  // sin tocar por estos campos -- se agregan aparte para no romper el uso
  // existente de "total" en reportes/UI de devoluciones.
  refundAmount Float?
  creditAmount Float?
  chargeAmount Float?
  chargeMethod PaymentMethod?
  reason       String?
  refundMethod PaymentMethod?
  createdAt    DateTime       @default(now())

  items ReturnItem[]

  @@index([tenantId])
  @@index([saleId])
  @@index([clientId])
  @@index([createdAt])
}

enum ReturnItemDirection {
  RETURNED
  EXCHANGE_OUT
}

model ReturnItem {
  id         String              @id @default(uuid())
  returnId   String
  return     Return              @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId  String
  product    Product             @relation(fields: [productId], references: [id])
  // Solo se completa para direction RETURNED -- de que linea de la venta
  // original vino, para poder sumar cuanto se devolvio ya de esa linea en
  // devoluciones parciales futuras (ver return.service.ts). Null para
  // EXCHANGE_OUT (producto nuevo, no viene de ningun SaleItem) y para las
  // filas viejas de antes de esta migracion.
  saleItemId String?
  saleItem   SaleItem?           @relation(fields: [saleItemId], references: [id])
  direction  ReturnItemDirection @default(RETURNED)
  quantity   Int
  quantityKg Float?
  unitPrice  Float
  subtotal   Float
  createdAt  DateTime            @default(now())

  @@index([returnId])
  @@index([productId])
  @@index([saleItemId])
}

// === PrintBox (impresion de tickets via ESP32, HTTP directo) ===
// DESKTOP_AGENT = mismo contrato (pairing/poll/ack/heartbeat), pero el
// cliente es la app de escritorio (desktop-agent/) en vez de un ESP32
// fisico -- imprime via el driver de Windows en vez de ESC/POS directo a
// una IP, asi que no completa printerIp. Ver desktop-agent/README.md.
enum PrintboxDeviceKind {
  ESP32
  DESKTOP_AGENT
}

enum PrintboxDeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED
}

enum PrintJobStatus {
  QUEUED
  PUBLISHED
  ACKED
  FAILED
}

// Un ESP32 fisico. El pairing inicial es local (el device levanta un server
// HTTP temporal en su IP de DHCP para cargar el codigo). Una vez emparejado,
// el ESP32 pasa a ser el que INICIA la conexion: hace long-poll a
// GET /printbox/devices/:id/poll preguntando si hay algo para imprimir, y
// el backend contesta con el ticket cuando llega uno (ver
// printbox.service.ts#pollForPrintJob y printbox/README.md, seccion "Por
// que pull y no push"). Elegido a proposito para no depender de
// port-forwarding/DNS propio en la LAN de cada cliente (un backend en
// Railway no puede abrir una conexion entrante a un device detras de NAT).
// deviceIp se sigue guardando via heartbeat/poll para diagnostico (ver
// panel), pero ya no se usa para direccionar nada.
model PrintboxDevice {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  name                 String
  kind                 PrintboxDeviceKind   @default(ESP32)
  status               PrintboxDeviceStatus @default(PENDING_PAIRING)
  hardwareId           String?              @unique
  printerIp            String?
  deviceIp             String?
  // Legacy del esquema anterior (push por HTTP directo a deviceIp/remoteHost)
  // -- ya no se usa para nada (ver comentario del modelo arriba). Se deja la
  // columna en vez de migrar para no tocar el schema de prod sin necesidad;
  // el campo quedó sin UI de edición en el panel.
  remoteHost           String?
  tokenEncrypted       String?
  pairingCode          String?              @unique
  pairingCodeExpiresAt DateTime?
  lastSeenAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  printJobs PrintJob[]

  @@index([tenantId])
  @@index([status])
}

// Registro/auditoria de cada ticket mandado por HTTP al PrintBox -- para
// poder ver en platform-admin "se publico, se imprimio, fallo" y
// reintentar a mano.
// saleId es una referencia opaca (sin FK) a proposito: esta tabla es
// auxiliar/operativa y no debe acoplarse al modelo Sale.
model PrintJob {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  deviceId    String?
  device      PrintboxDevice? @relation(fields: [deviceId], references: [id])
  saleId      String?
  payload     Json
  status      PrintJobStatus  @default(QUEUED)
  publishedAt DateTime?
  ackedAt     DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
