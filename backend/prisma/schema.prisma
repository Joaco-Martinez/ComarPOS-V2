// Config de la tienda online publica del tenant (doc "tienda online por
// tenant") - tabla separada de Tenant (que ya tiene ~40 columnas), mismo
// criterio que ArcaConfig. isEnabled la prende/apaga a mano el dueño del
// negocio (independiente de si el plan incluye el modulo, ver
// PlanFeatureKey.tiendaOnline) - storefrontTenant.ts controla el bloqueo por
// plan/suscripcion, esto controla si el dueño la quiere visible ahora mismo.
model TenantStorefrontConfig {
  id            String  @id @default(uuid())
  tenantId      String  @unique
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  isEnabled     Boolean @default(false)
  // Nombre publico de la tienda, puede diferir de Tenant.name (razon
  // social) - si es null, se usa Tenant.name como fallback.
  storeName     String?
  description   String? @db.Text
  bannerUrl     String?
  bannerId      String?
  // Hex simple (#RRGGBB), se aplica como variable CSS en el frontend de la
  // tienda - no es un sistema de theming completo a proposito (doc fase 4).
  accentColor   String?
  // [{ day: 0-6, opens: "09:00", closes: "18:00", closed: boolean }] - forma
  // libre, se valida/formatea en el frontend, no hace falta un modelo aparte.
  businessHours Json?

  pickupEnabled      Boolean           @default(true)
  deliveryEnabled    Boolean           @default(false)
  // Sucursal de origen de la tienda (retiro/envio/descuento de stock al
  // convertir un pedido en venta) - explicito a proposito, NO se asume que
  // sea la BusinessLocation con isDefault=true (ese flag ya se usa para otra
  // cosa en el resto del sistema y no se audito su significado actual antes
  // de reusarlo acá).
  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])

  transferInstructions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum OrderStatus {
  PENDING // recien creado, esperando confirmacion/pago
  PAYMENT_PENDING_REVIEW // transferencia con comprobante subido, esperando que el negocio la verifique
  CONFIRMED // pago verificado (o efectivo aceptado) - listo para preparar/entregar
  CONVERTED // ya se convirtio en una Sale real (ver order.service.ts#convertToSale)
  CANCELLED
  EXPIRED // reservado para un barrido futuro de pedidos abandonados sin pagar - no se usa todavia
}

enum OrderPaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  MERCADOPAGO
}

enum OrderPaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  APPROVED
  REJECTED
}

// Pedido de la tienda online publica (doc "tienda online por tenant") -
// modelo separado de Sale a proposito: un pedido de invitado no deberia
// descontar stock ni existir como venta "real" hasta que el negocio lo
// procesa o el pago se confirma (Sale, en cambio, descuenta stock
// inmediatamente al crearse, incluso en PENDING - no encaja con un carrito
// publico sin friccion). Se convierte en una Sale real recien en
// order.service.ts#convertToSale.
model Order {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Identificador opaco para que el comprador invitado consulte SU pedido
  // sin poder enumerar pedidos ajenos (mismo criterio que
  // RepairOrder.approvalToken) - nunca se expone el id interno en la URL
  // publica.
  publicToken String @unique @default(uuid())

  status OrderStatus @default(PENDING)

  // Invitado + cuenta opcional: si el comprador esta logueado como CLIENTE
  // de este mismo tenant, se completa clientId/userId para historial: si
  // no, queda null y los datos de contacto abajo son la unica referencia.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  customerName  String
  customerPhone String?
  customerEmail String?

  items OrderItem[]

  subtotal Float
  total    Float

  deliveryMethod          DeliveryMethod @default(PICKUP)
  deliveryCost            Float          @default(0)
  deliveryDistanceKm      Float?
  deliveryPricePerKm      Float?
  deliveryAddressSnapshot String?
  deliveryLat             Float?
  deliveryLng             Float?

  // Sucursal de origen (retiro/envio) - copiada de
  // TenantStorefrontConfig.businessLocationId al crear el pedido, para que
  // no cambie retroactivamente si el negocio la cambia despues.
  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])

  paymentMethod OrderPaymentMethod
  paymentStatus OrderPaymentStatus @default(PENDING)

  // Mercado Pago (pago con las credenciales propias del tenant, ver
  // storefrontMercadoPago.service.ts) - null salvo paymentMethod=MERCADOPAGO.
  mpPreferenceId String?
  mpPaymentId    String?

  transferProofUrl         String?
  transferProofId          String?
  transferVerifiedAt       DateTime?
  transferVerifiedByUserId String?
  transferVerifiedByUser   User?     @relation("OrderTransferVerifiedBy", fields: [transferVerifiedByUserId], references: [id])

  customerNotes String? @db.Text

  // Se completa recien al convertir el pedido en una venta real (ver
  // order.service.ts#convertToSale) - null hasta entonces.
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  convertedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@index([publicToken])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int?
  quantityKg Float?

  unitPrice Float
  subtotal  Float

  productNameSnapshot String?
  productSkuSnapshot  String?

  @@index([orderId])
  @@index([productId])
}

// Descuento(s) multiples de una cotizacion (pantalla de Cotizaciones, ver
// sale.discounts.ts). Ej: "Efectivo 15%" y "Tarjeta 12%" cargados en la misma
// cotizacion como alternativas (Sale.discountsAccumulate = false, se aplica
// solo el de mayor prioridad por "order") o acumulados en cadena
// (discountsAccumulate = true).
model SaleDiscount {
  id        String       @id @default(uuid())
  saleId    String
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  label     String?
  type      DiscountType
  value     Float
  applied   Boolean      @default(true)
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([saleId])
}

// Modulo de Servicios / Reparaciones tecnicas: recibir un equipo, presupuestar
// el arreglo (repuestos reales del catalogo -- descuentan stock al facturar
// igual que una venta normal -- y/o lineas libres de mano de obra) y que el
// cliente apruebe el presupuesto desde un link publico (approvalToken, sin
// login, mismo patron que PrintboxDevice.pairingCode). Cobrar/facturar la
// reparacion genera una Sale normal (ver repairOrder.service.ts#checkout) que
// reusa el circuito existente de pagos/AFIP/cuenta corriente en vez de
// reimplementarlo.
model RepairOrder {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])

  deviceType           String
  deviceBrand          String?
  deviceModel          String?
  deviceSerial         String?
  deviceAccessories    String?
  deviceConditionNotes String?
  reportedIssue        String
  diagnosis            String?

  status      RepairOrderStatus @default(RECEIVED)
  totalAmount Float             @default(0)

  approvalToken          String?   @unique
  approvalTokenExpiresAt DateTime?
  budgetedAt             DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?

  estimatedDeliveryDate DateTime?
  receivedAt            DateTime  @default(now())
  deliveredAt           DateTime?

  // Se completa al cobrar (checkout) -- de ahi en mas la plata/factura de
  // esta reparacion se administra como cualquier otra Sale.
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RepairOrderItem[]

  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([status])
  @@index([createdAt])
}

model RepairOrderItem {
  id            String              @id @default(uuid())
  repairOrderId String
  repairOrder   RepairOrder         @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  type          RepairOrderItemType
  // Si esta seteado, la linea es un repuesto real del catalogo -- al cobrar
  // la reparacion se factura como ese producto (descuenta stock salvo que
  // sea isService). Si es null, es mano de obra u otro concepto de texto
  // libre que no toca inventario.
  productId     String?
  product       Product?            @relation(fields: [productId], references: [id])
  description   String
  quantity      Int                 @default(1)
  unitPrice     Float
  subtotal      Float
  // unitPrice/subtotal son precio final (con IVA incluido), mismo criterio
  // que Sale/SaleItem -- ivaRate solo se usa para "destapar" el neto al
  // mostrar/facturar (ver repairOrder.service.ts, generarPresupuestoReparacionPDF.ts).
  // Default 21 igual que Product.ivaRate; si la linea es un repuesto real
  // se autocompleta con el ivaRate del producto al cargarla.
  ivaRate       Float               @default(21)
  createdAt     DateTime            @default(now())

  @@index([repairOrderId])
  @@index([productId])
}

// Modulo de Hoteleria: tipos de habitacion con su tarifa por noche, las
// habitaciones fisicas de cada tipo, y las reservas sobre ellas. Al hacer
// checkout de una reserva se genera una Sale normal (ver
// reservation.service.ts#checkout), mismo patron que RepairOrder mas arriba
// -- reusa el circuito existente de pagos/AFIP/cuenta corriente en vez de
// reimplementarlo.
model RoomType {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String
  nightlyRate Float
  capacity    Int      @default(2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]

  @@index([tenantId])
}

model Room {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  roomTypeId         String
  roomType           RoomType          @relation(fields: [roomTypeId], references: [id])
  number             String
  floor              String?
  status             RoomStatus        @default(LIBRE)
  notes              String?
  isActive           Boolean           @default(true)
  // Direccion propia de la habitacion/unidad, independiente de
  // businessLocationId -- pensado para un agente con varias cabañas
  // dispersas que no tiene (o no quiere cargar) una BusinessLocation por
  // cada una. Ambas conviven: un hotel sigue pudiendo agrupar habitaciones
  // bajo una sucursal, y una cabaña suelta puede en cambio cargar solo su
  // propia direccion. Mismo naming que BusinessLocation.address* arriba.
  addressStreet      String?
  addressCity        String?
  addressProvince    String?
  latitude           Float?
  longitude          Float?
  // Foto de la habitacion/cabaña -- mismo patron que Product.imageUrl/imageId
  // (product.write.ts#updateImage): sube a Cloudinary, guarda url/publicId.
  imageUrl           String?
  imageId            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  reservations       Reservation[]

  @@index([tenantId])
  @@index([businessLocationId])
  @@index([roomTypeId])
  @@index([status])
}

// checkInDate/checkOutDate son las fechas planificadas (para el calendario
// de disponibilidad); actualCheckInAt/actualCheckOutAt quedan null hasta
// que el huesped efectivamente llega/se va. nightlyRateSnapshot congela la
// tarifa del RoomType al momento de reservar (igual que
// RepairOrderItem.unitPrice), para no romper reservas viejas si despues se
// cambia la tarifa del tipo de habitacion. saleId se completa recien al
// hacer checkout (cobrar), igual que RepairOrder.saleId. guestName/guestPhone
// permiten cargar una reserva de un huesped ocasional sin tener que crear
// un Client (clientId sigue siendo opcional, para vincularla si ya existe).
model Reservation {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  roomId             String
  room               Room              @relation(fields: [roomId], references: [id])
  clientId           String?
  client             Client?           @relation(fields: [clientId], references: [id])
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])

  guestName  String
  guestPhone String?

  checkInDate      DateTime
  checkOutDate     DateTime
  actualCheckInAt  DateTime?
  actualCheckOutAt DateTime?

  nightlyRateSnapshot Float
  totalAmount         Float
  status              ReservationStatus @default(RESERVADA)
  notes               String?

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([roomId])
  @@index([clientId])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
}

