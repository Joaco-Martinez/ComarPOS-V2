generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Multi-tenant (doc seccion 6) ===
enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model Tenant {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  isActive                  Boolean  @default(true)
  logoUrl                   String?
  logoId                    String?
  // Version rasterizada del logo para impresion termica (ESC/POS GS v 0,
  // 1bpp), generada automaticamente al subir logoUrl (ver
  // services/printbox/logoRaster.service.ts). Separada de logoUrl porque
  // el ESP32 no decodifica PNG/JPEG arbitrario, necesita el bitmap ya
  // convertido y listo para mandarle a la impresora tal cual.
  logoEscposRasterBase64    String?  @db.Text
  // Bridge HTTP viejo (POS_LOCAL_URL, ver ticket.service.ts) para imprimir
  // sin tener ningun PrintboxDevice pareado -- pensado unicamente para el
  // setup fisico on-prem de grupo-vj (unico backfill=true, ver migracion).
  // Un tenant nuevo sin PrintboxDevice pareado NO debe caer a este bridge
  // (le pegaria a la red local de grupo-vj, no a la suya): en cambio recibe
  // una notificacion invitandolo a pedir su propia PrintBox.
  legacyLocalPrinterEnabled Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // billing manual (super-admin de plataforma)
  subscriptionStatus TenantSubscriptionStatus @default(ACTIVE)
  paidUntil          DateTime?
  suspendedAt        DateTime?
  notes              String?

  // Prueba gratis self-service (ver trialSignup.service.ts): tenants creados
  // desde /trial-signup arrancan en subscriptionStatus=TRIAL con trialEndsAt
  // seteado; se bloquean solos al vencer (ver middleware/tenant.ts,
  // getTenantBlockCode) sin necesidad de un cron. Queda null para tenants
  // creados por el super-admin o el script createTenant.ts.
  trialEndsAt  DateTime?
  // Telefono de contacto de quien se dio de alta (obligatorio en
  // /trial-signup, ver trialSignup.service.ts) - lo usa el super-admin para
  // hacer seguimiento comercial/cobranza. Null para tenants creados a mano.
  contactPhone String?

  // Suscripcion self-service via Mercado Pago (ver services/billing/*.ts).
  // mpPreapprovalId es el id de la "preapproval" (suscripcion recurrente) de
  // MP asociada a este tenant - el webhook la usa para encontrar a que
  // tenant corresponde cada pago/cancelacion y pisa subscriptionStatus/
  // paidUntil solo (no reemplaza el billing manual: un tenant sin
  // mpPreapprovalId sigue gestionandose a mano desde el panel, como hasta
  // ahora). mpSubscriptionAmount queda fijo al monto pagado por primera vez
  // (precio de lanzamiento "de por vida") aunque el precio de lista suba mas
  // adelante para nuevos suscriptores.
  mpPreapprovalId      String? @unique
  mpSubscriptionAmount Float?
  // Id de uno de los PLANS en config/billing.ts ("esencial" | "profesional"
  // | "multisucursal") -- default al plan recomendado (el que era el unico
  // plan antes de tener 3), asi los tenants existentes no quedan en un
  // plan mas chico del que ya venian usando de hecho (sucursales/usuarios
  // sin limite). Determina el precio de checkout (billing.service.ts) y
  // los topes de sucursales/productos/usuarios (planLimits.service.ts).
  planId               String  @default("profesional")

  // Rubro elegido en /trial-signup (slug de BUSINESS_PRESETS, ver
  // data/businessPresets.ts) - dispara la precarga de categorias/productos de
  // ejemplo al crear el tenant (businessPreset.service.ts#apply). Se guarda
  // aunque el usuario haya destildado todo el preset, solo como dato
  // informativo de que rubro dijo tener; no vuelve a aplicarse despues del
  // alta. Null para tenants creados a mano (createTenant.ts) o que eligieron
  // "prefiero configurarlo yo".
  businessType         String?

  // Override de modulos por TENANT puntual, no por plan (a diferencia de
  // PlanFeatureConfig, que pisa el default de un plan entero -- ver
  // planFeature.service.ts#checkFeature y billing.service.ts#getStatus,
  // que hacen merge de esto por encima del feature-set del plan). Pensado
  // para modulos verticales como "hoteleria": apagado por defecto en todos
  // los planes, se prende a mano tenant por tenant desde /platform-admin
  // segun si ese negocio puntual lo necesita. Mapa parcial
  // { [PlanFeatureKey]: boolean }, null = sin overrides.
  featureOverrides Json?

  // Datos de cabecera para tickets/documentos impresos (printbox). Si son
  // null, ticket.service.ts cae a `name` para no dejar el ticket en blanco.
  ticketBusinessName String?
  ticketCuit         String?
  ticketAddress      String?
  ticketPhone        String?
  ticketEmail        String?

  // Precio de envio por km propio del negocio (ver delivery.service.ts). Si
  // es null, se usa el default global DELIVERY_PRICE_PER_KM (env var) - asi
  // que cada tenant puede pisarlo desde Configuracion > Empresa sin que haga
  // falta redeployar para cambiar un precio.
  deliveryPricePerKm Float?

  // Tasa del programa de fidelizacion (modulo "fidelidad", ver
  // loyalty.service.ts) - antes hardcodeada, ahora configurable por tenant
  // desde /loyalty/settings. loyaltyPointsPerAmount = puntos ganados por
  // cada $1 de venta (default 0.01 = 1 punto cada $100). loyaltyPointValueArs
  // = valor en pesos de cada punto al canjear (default 1 = 1 punto = $1).
  loyaltyPointsPerAmount Float @default(0.01)
  loyaltyPointValueArs   Float @default(1)

  // Progreso de la guia de arranque para negocios nuevos (ver /guia en el
  // frontend y onboarding.service.ts). Mapa { [stepId]: boolean }, null hasta
  // que se marca el primer paso. Es del negocio, no de un usuario puntual:
  // cualquier empleado que entre ve el mismo progreso.
  onboardingChecklist Json?

  paymentLogs     TenantPaymentLog[]
  printboxDevices PrintboxDevice[]
  printJobs       PrintJob[]
  pushTokens      PushToken[]

  users             User[]
  clients           Client[]
  products          Product[]
  sales             Sale[]
  finances          Finance[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  invoicesAfip      InvoiceAfip[]
  remitos           Remito[]
  arcaConfigs       ArcaConfig[]
  businessLocations BusinessLocation[]
  arcaAuditLogs     ArcaAuditLog[]
  productCategories ProductCategory[]
  cbteCounters      CbteCounter[]
  vatSettlements    VatSettlement[]
  // new modules
  suppliers         Supplier[]
  cashSessions      CashSession[]
  recurringExpenses RecurringExpense[]
  exchangeRates     ExchangeRate[]
  salesGoals        SalesGoal[]
  promotions        Promotion[]
  stockCounts       StockCount[]
  purchaseOrders    PurchaseOrder[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  priceLists        PriceList[]
  storefrontConfig  TenantStorefrontConfig?
  mpConfig          TenantMpConfig?
  orders            Order[]
  loyaltyAccounts   LoyaltyAccount[]
  returns           Return[]
  productStocks     ProductStock[]
  repairOrders      RepairOrder[]
  financeAccounts   FinanceAccount[]
  roomTypes         RoomType[]
  rooms             Room[]
  reservations      Reservation[]
  convertedFromLead SalesLead?
}

// === Platform admin (super-admin de SaaS, fuera de cualquier tenant) ===
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentLogs TenantPaymentLog[]
  salesLeads  SalesLead[]
}

// CRM chico de prospeccion "puerta a puerta" (doc: Joaco visita locales en
// persona para vender ComarPOS) - deliberadamente afuera de cualquier
// Tenant, porque un prospecto todavia NO es un negocio dado de alta en el
// sistema, es una visita comercial que puede o no convertirse en un tenant
// mas adelante (createTenant.ts sigue siendo el alta real, esto no la
// reemplaza).
model SalesLead {
  id               String                @id @default(uuid())
  businessName     String
  address          String?
  contactName      String?
  phone            String?
  // Con quien se hablo en el local - si fue un empleado (no el dueño), el
  // frontend resalta un recordatorio de "preguntar por el dueño" en la
  // proxima visita (derivado de este campo, no un campo aparte). Null =
  // todavia no se cargo/no se sabe.
  contactRole      SalesLeadContactRole?
  // Requerimiento especial / algo puntual que pidio probar - texto libre a
  // proposito, cada local pide algo distinto.
  notes            String?               @db.Text
  status           SalesLeadStatus       @default(PENDIENTE)
  createdByAdminId String?
  createdByAdmin   PlatformAdmin?        @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Tenant real creado a partir de este prospecto (ver
  // platformAdmin.controller.ts#createDemoTenant, boton "Crear cuenta demo"
  // del CRM) - se completa junto con status=CLIENTE, nunca por separado. Si
  // ese tenant se borra despues (ver platformTenant.service.ts#deleteTenant),
  // queda null de nuevo (onDelete: SetNull) para no dejar el prospecto
  // roto/inaccesible, pero el status=CLIENTE no se revierte solo.
  convertedTenantId String? @unique
  convertedTenant   Tenant? @relation(fields: [convertedTenantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdByAdminId])
}

enum SalesLeadStatus {
  PENDIENTE
  VISITADO
  INTERESADO
  NO_INTERESADO
  CLIENTE
}

enum SalesLeadContactRole {
  DUENO
  EMPLEADO
}

// Espejo de los "preapproval_plan" creados del lado de Mercado Pago para
// cada plan de config/billing.ts (PLANS sigue siendo la fuente de verdad
// de precio/limites -- esta tabla solo guarda el id que devolvio MP la
// primera vez que se creo, para no duplicarlo si se vuelve a apretar el
// boton de sincronizar). planId matchea PLANS[].id ("esencial" |
// "profesional" | "multisucursal"), no es una FK -- son constantes de
// codigo, no una tabla.
model MpPreapprovalPlan {
  id        String   @id @default(uuid())
  planId    String   @unique
  mpPlanId  String   @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Override editable desde el panel de super-admin de que modulos incluye
// cada plan (PlanFeatureKey en config/billing.ts -- ya cubre TODOS los
// modulos del sistema, no solo fidelidad/promociones/cuentasCorrientes) y de
// su precio. PLANS sigue siendo la fuente de verdad default (features +
// precio) -- esta tabla solo pisa lo que un admin cambio a mano desde
// /platform-admin; sin fila para un plan, rige el default hardcodeado.
// priceArs/regularPriceArs nulos = usar el default de PLANS. Ver
// planFeatureConfig.service.ts (cachea en memoria, se invalida al escribir).
model PlanFeatureConfig {
  id              String   @id @default(uuid())
  planId          String   @unique
  features        Json
  priceArs        Float?
  regularPriceArs Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TenantPaymentLog {
  id              String                   @id @default(uuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  platformAdminId String?
  platformAdmin   PlatformAdmin?           @relation(fields: [platformAdminId], references: [id])
  previousStatus  TenantSubscriptionStatus
  newStatus       TenantSubscriptionStatus
  note            String?
  paidUntil       DateTime?
  createdAt       DateTime                 @default(now())

  @@index([tenantId])
  @@index([platformAdminId])
}

model User {
  id                         String                    @id @default(uuid())
  tenantId                   String?
  tenant                     Tenant?                   @relation(fields: [tenantId], references: [id])
  email                      String
  password                   String
  name                       String
  role                       Role
  isActive                   Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  // Se pisa en cada login exitoso (ver auth.service.ts) - usado por
  // platform-admin para auditar si una cuenta se llego a usar o no.
  lastLoginAt                DateTime?
  passwordResetExpires       DateTime?
  passwordResetToken         String?                   @unique
  mustChangePassword         Boolean                   @default(false)
  // Layout personal de accesos rapidos del mobile nav (BottomNav.tsx),
  // por usuario. null = sin personalizar, usa el orden default de
  // navConfig.ts (ver frontend/lib/quickAccess.ts#buildEffectiveNav).
  quickAccessConfig          Json?
  // Sucursal "de base" del usuario (doc "puntos de venta separados") - el
  // POS y la Caja arrancan con esta ubicacion en vez de la default global
  // del tenant (ver sale.stock.ts#resolveStockLocationId,
  // cashSession.service.ts#openSession). Null = sin asignar, sigue usando
  // el default del tenant como antes (tenants de 1 sola sucursal no
  // necesitan tocar esto nunca).
  defaultBusinessLocationId  String?
  defaultBusinessLocation    BusinessLocation?         @relation(fields: [defaultBusinessLocationId], references: [id])
  // Si esta prendido, el usuario NO puede vender ni abrir caja en otra
  // sucursal que no sea defaultBusinessLocation - lo valida el backend
  // (resolveStockLocationId/openSession), no es solo un default sugerido
  // en el frontend. Solo tiene efecto si defaultBusinessLocationId esta
  // seteado. Apagado por defecto: no cambia nada para nadie hasta que un
  // admin lo prenda a mano para un usuario puntual.
  restrictToDefaultLocation  Boolean                   @default(false)
  accountMovements           AccountMovement[]
  client                     Client?
  remitos                    Remito[]
  Sale                       Sale[]
  StockMovements             StockMovement[]
  purchases                  Purchase[]
  // new modules
  cashSessions               CashSession[]
  stockCounts                StockCount[]
  purchaseOrders             PurchaseOrder[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  returns                    Return[]
  pushTokens                 PushToken[]
  repairOrders               RepairOrder[]
  vatSettlementsClosed       VatSettlement[]
  supplierAccountMovements   SupplierAccountMovement[]
  reservations               Reservation[]
  orders                     Order[]
  orderTransferVerifications Order[]                   @relation("OrderTransferVerifiedBy")

  @@unique([email])
  @@index([role])
  @@index([isActive])
  @@index([passwordResetToken])
  @@index([tenantId])
  @@index([defaultBusinessLocationId])
}

model Client {
  id                String            @id @default(uuid())
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
  nombre            String
  // Unico dato realmente obligatorio para el alta rapida (ver
  // client.registration.ts#createClient) -- pensado para poder cargar un
  // cliente al vuelo desde el buscador de POS/Servicios/Cuentas Corrientes
  // sin frenar la operacion pidiendo datos que todavia no se tienen.
  apellido          String?
  dni               String?
  // Que tipo de documento es el numero de arriba (dni) -- lo elige el
  // usuario en el form en vez de inferirlo de la cantidad de digitos, para
  // no depender de heuristicas al facturar (ver backend/src/afip/utils/afipMappers.ts,
  // que si infiere DNI/CUIT/CUIL por longitud en el flujo de facturacion manual).
  documentType      DocumentType      @default(DNI)
  // Condicion frente al IVA del cliente (AFIP/ARCA) -- mismos 5 valores que
  // ArcaConfig.ivaCondition (ver backend/src/afip/ivaCondition.ts), pero aca
  // referida al cliente, no al tenant. Determina si se le puede facturar A.
  ivaCondition      String?
  telefono          String?
  gmail             String?
  category          CategoryClient    @default(Price)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userId            String?           @unique
  currentBalance    Float             @default(0)
  creditLimit       Float?
  isAccountEnabled  Boolean           @default(false)
  addressApartment  String?
  addressCity       String?
  addressFloor      String?
  addressNotes      String?
  addressNumber     String?
  addressPostalCode String?
  addressProvince   String?
  addressStreet     String?
  latitude          Float?
  longitude         Float?
  // price list
  priceListId       String?
  priceList         PriceList?        @relation(fields: [priceListId], references: [id])
  accountMovements  AccountMovement[]
  user              User?             @relation(fields: [userId], references: [id])
  remitos           Remito[]
  sales             Sale[]
  loyaltyAccount    LoyaltyAccount?
  returns           Return[]
  repairOrders      RepairOrder[]
  reservations      Reservation[]
  orders            Order[]

  @@unique([tenantId, dni])
  @@unique([tenantId, gmail])
  @@index([dni])
  @@index([gmail])
  @@index([category])
  @@index([userId])
  @@index([tenantId])
  @@index([priceListId])
}

model BusinessLocation {
  id                 String                   @id @default(uuid())
  tenantId           String?
  tenant             Tenant?                  @relation(fields: [tenantId], references: [id])
  name               String
  type               BusinessLocationType     @default(BRANCH)
  addressStreet      String?
  addressNumber      String?
  addressCity        String?
  addressProvince    String?
  addressPostalCode  String?
  addressNotes       String?
  latitude           Float?
  longitude          Float?
  isDefault          Boolean                  @default(false)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  remitos            Remito[]
  sales              Sale[]
  cashSessions       CashSession[]
  productStocks      ProductStock[]
  stockMovementsFrom StockMovement[]          @relation("StockMovementFrom")
  stockMovementsTo   StockMovement[]          @relation("StockMovementTo")
  purchases          Purchase[]
  stockLocationSales Sale[]                   @relation("SaleStockLocation")
  stockCounts        StockCount[]
  repairOrders       RepairOrder[]
  rooms              Room[]
  reservations       Reservation[]
  storefrontConfigs  TenantStorefrontConfig[]
  orders             Order[]
  defaultForUsers    User[]

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
  @@index([tenantId])
}

// Stock de un producto en una ubicacion (BusinessLocation) puntual.
// Reemplaza el split fijo Product.stockLocal/stockDeposito (ver doc de
// migracion "ubicaciones de stock dinamicas") - cada tenant puede tener 0,
// 1 o N ubicaciones, no dos fijas. Se mantiene siempre una fila por cada
// combinacion producto x ubicacion existente (con 0 si no hay stock) para
// no tener que distinguir "fila ausente" de "stock en cero" en el resto
// del codigo.
model ProductStock {
  id                 String           @id @default(uuid())
  tenantId           String?
  tenant             Tenant?          @relation(fields: [tenantId], references: [id])
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessLocationId String
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  quantity           Int              @default(0)
  quantityKg         Float            @default(0)
  minQuantity        Int?
  minQuantityKg      Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([productId, businessLocationId])
  @@index([productId])
  @@index([businessLocationId])
  @@index([tenantId])
}

model ProductCategory {
  id          String    @id @default(uuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@index([tenantId])
}

model Product {
  id                  String              @id @default(uuid())
  tenantId            String?
  tenant              Tenant?             @relation(fields: [tenantId], references: [id])
  name                String
  description         String?
  type                ProductType         @default(SIMPLE)
  price               Float
  wholesalePrice      Float
  clientPrice         Float
  minStock            Int?
  stockLocal          Int                 @default(0)
  stockDeposito       Int                 @default(0)
  categoryId          String?
  supplierId          String?
  supplier            Supplier?           @relation(fields: [supplierId], references: [id])
  imageUrl            String?
  imageId             String?
  isActive            Boolean             @default(true)
  sku                 String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  saleUnit            SaleUnit            @default(UNIT)
  pricePerKg          Float?
  wholesalePricePerKg Float?
  clientPricePerKg    Float?
  stockLocalKg        Float               @default(0)
  stockDepositoKg     Float               @default(0)
  minStockKg          Float?              @default(0)
  purchasePrice       Float               @default(0)
  ivaRate             Float               @default(21)
  isService           Boolean             @default(false)
  // Producto fisico que se puede seguir vendiendo sin importar el stock
  // cargado (ej. algo que no se quiere contar/tildar en cada venta) -
  // distinto de isService: NO se excluye de reportes/alertas de stock por
  // ser un servicio, simplemente nunca bloquea la venta por falta de stock
  // y no descuenta/restaura stock al vender/cancelar (ver shouldDiscountStock
  // en sale.pricing.ts).
  unlimitedStock      Boolean             @default(false)
  minStockDeposito    Int?
  minStockDepositoKg  Float?
  alerts              Alert[]
  BoxContent          BoxContent[]
  category            ProductCategory?    @relation(fields: [categoryId], references: [id])
  usedIn              ProductComponent[]  @relation("ComponentProduct")
  components          ProductComponent[]  @relation("CompositeProduct")
  stats               ProductStats[]
  remitoItems         RemitoItem[]
  SaleItem            SaleItem[]
  StockMovement       StockMovement[]
  purchaseItems       PurchaseItem[]
  // new modules
  stockCountItems     StockCountItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  priceListItems      PriceListItem[]
  returnItems         ReturnItem[]
  stock               ProductStock[]
  repairOrderItems    RepairOrderItem[]
  orderItems          OrderItem[]

  @@unique([tenantId, sku])
  @@index([sku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([type])
  @@index([isActive])
  @@index([isActive, name])
  @@index([tenantId])
}

model ProductComponent {
  id          String   @id @default(uuid())
  compositeId String
  componentId String
  quantity    Int?
  quantityKg  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  component   Product  @relation("ComponentProduct", fields: [componentId], references: [id])
  composite   Product  @relation("CompositeProduct", fields: [compositeId], references: [id], onDelete: Cascade)

  @@unique([compositeId, componentId])
  @@index([componentId])
}

enum TenantMpConfigStatus {
  INACTIVE
  ACTIVE
  ERROR
}

// Credenciales de Mercado Pago del NEGOCIO (para que cobre a SUS clientes en
// la tienda online) - tabla separada de ArcaConfig/billing.mercadoPago.service.ts
// a proposito: eso es la cuenta de MP de ComarPOS (cobrarle la suscripcion
// SaaS al tenant), esto es la cuenta de MP del tenant (cobrarle a sus
// propios clientes). Mismo mecanismo de encriptado que ArcaConfig
// (tenantMpCrypto.service.ts, AES-256-GCM, secret propio MP_CREDENTIALS_SECRET
// para no acoplar el blast radius de ARCA y MP).
model TenantMpConfig {
  id                   String               @id @default(uuid())
  tenantId             String               @unique
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  publicKey            String?
  accessTokenEncrypted String?
  status               TenantMpConfigStatus @default(INACTIVE)
  lastError            String?
  lastCheckAt          DateTime?
  isActive             Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([tenantId])
}

model ArcaConfig {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  businessName       String
  cuit               String
  ivaCondition       String?
  environment        ArcaEnvironment   @default(HOMOLOGACION)
  status             ArcaConfigStatus  @default(INACTIVE)
  certEncrypted      String?
  keyEncrypted       String?
  certExpiresAt      DateTime?
  lastTokenAt        DateTime?
  lastCheckAt        DateTime?
  lastError          String?
  isActive           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  activityStart      DateTime?
  certAlias          String?
  defaultConcept     Int               @default(1)
  defaultCurrencyId  String            @default("PES")
  defaultPointOfSale Int?
  fiscalAddress      String?
  iibb               String?
  lastSuccessAt      DateTime?
  scope              String            @unique @default("GRUPO_VJ")
  csrEncrypted       String?
  csrGeneratedAt     DateTime?
  tokens             AfipToken[]
