// Modulo de Servicios / Reparaciones tecnicas: recibir un equipo, presupuestar
// el arreglo (repuestos reales del catalogo -- descuentan stock al facturar
// igual que una venta normal -- y/o lineas libres de mano de obra) y que el
// cliente apruebe el presupuesto desde un link publico (approvalToken, sin
// login, mismo patron que PrintboxDevice.pairingCode). Cobrar/facturar la
// reparacion genera una Sale normal (ver repairOrder.service.ts#checkout) que
// reusa el circuito existente de pagos/AFIP/cuenta corriente en vez de
// reimplementarlo.
model RepairOrder {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  businessLocationId String?
  businessLocation   BusinessLocation? @relation(fields: [businessLocationId], references: [id])

  deviceType           String
  deviceBrand          String?
  deviceModel          String?
  deviceSerial         String?
  deviceAccessories    String?
  deviceConditionNotes String?
  reportedIssue        String
  diagnosis            String?

  status      RepairOrderStatus @default(RECEIVED)
  totalAmount Float             @default(0)

  approvalToken          String?   @unique
  approvalTokenExpiresAt DateTime?
  budgetedAt             DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?

  estimatedDeliveryDate DateTime?
  receivedAt            DateTime  @default(now())
  deliveredAt           DateTime?

  // Se completa al cobrar (checkout) -- de ahi en mas la plata/factura de
  // esta reparacion se administra como cualquier otra Sale.
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RepairOrderItem[]

  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([status])
  @@index([createdAt])
}

model RepairOrderItem {
  id            String              @id @default(uuid())
  repairOrderId String
  repairOrder   RepairOrder         @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  type          RepairOrderItemType
  // Si esta seteado, la linea es un repuesto real del catalogo -- al cobrar
  // la reparacion se factura como ese producto (descuenta stock salvo que
  // sea isService). Si es null, es mano de obra u otro concepto de texto
  // libre que no toca inventario.
  productId     String?
  product       Product?            @relation(fields: [productId], references: [id])
  description   String
  quantity      Int                 @default(1)
  unitPrice     Float
  subtotal      Float
  // unitPrice/subtotal son precio final (con IVA incluido), mismo criterio
  // que Sale/SaleItem -- ivaRate solo se usa para "destapar" el neto al
  // mostrar/facturar (ver repairOrder.service.ts, generarPresupuestoReparacionPDF.ts).
  // Default 21 igual que Product.ivaRate; si la linea es un repuesto real
  // se autocompleta con el ivaRate del producto al cargarla.
  ivaRate       Float               @default(21)
  createdAt     DateTime            @default(now())

  @@index([repairOrderId])
  @@index([productId])
}

