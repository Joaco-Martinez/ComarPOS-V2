// === PrintBox (impresion de tickets via ESP32, HTTP directo) ===
// DESKTOP_AGENT = mismo contrato (pairing/poll/ack/heartbeat), pero el
// cliente es la app de escritorio (desktop-agent/) en vez de un ESP32
// fisico -- imprime via el driver de Windows en vez de ESC/POS directo a
// una IP, asi que no completa printerIp. Ver desktop-agent/README.md.
enum PrintboxDeviceKind {
  ESP32
  DESKTOP_AGENT
}

enum PrintboxDeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED
}

enum PrintJobStatus {
  QUEUED
  PUBLISHED
  ACKED
  FAILED
}

// Un ESP32 fisico. El pairing inicial es local (el device levanta un server
// HTTP temporal en su IP de DHCP para cargar el codigo). Una vez emparejado,
// el ESP32 pasa a ser el que INICIA la conexion: hace long-poll a
// GET /printbox/devices/:id/poll preguntando si hay algo para imprimir, y
// el backend contesta con el ticket cuando llega uno (ver
// printbox.service.ts#pollForPrintJob y printbox/README.md, seccion "Por
// que pull y no push"). Elegido a proposito para no depender de
// port-forwarding/DNS propio en la LAN de cada cliente (un backend en
// Railway no puede abrir una conexion entrante a un device detras de NAT).
// deviceIp se sigue guardando via heartbeat/poll para diagnostico (ver
// panel), pero ya no se usa para direccionar nada.
model PrintboxDevice {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  name                 String
  kind                 PrintboxDeviceKind   @default(ESP32)
  status               PrintboxDeviceStatus @default(PENDING_PAIRING)
  hardwareId           String?              @unique
  printerIp            String?
  deviceIp             String?
  // Legacy del esquema anterior (push por HTTP directo a deviceIp/remoteHost)
  // -- ya no se usa para nada (ver comentario del modelo arriba). Se deja la
  // columna en vez de migrar para no tocar el schema de prod sin necesidad;
  // el campo quedó sin UI de edición en el panel.
  remoteHost           String?
  tokenEncrypted       String?
  pairingCode          String?              @unique
  pairingCodeExpiresAt DateTime?
  lastSeenAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  printJobs PrintJob[]

  @@index([tenantId])
  @@index([status])
}

// Registro/auditoria de cada ticket mandado por HTTP al PrintBox -- para
// poder ver en platform-admin "se publico, se imprimio, fallo" y
// reintentar a mano.
// saleId es una referencia opaca (sin FK) a proposito: esta tabla es
// auxiliar/operativa y no debe acoplarse al modelo Sale.
model PrintJob {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  deviceId    String?
  device      PrintboxDevice? @relation(fields: [deviceId], references: [id])
  saleId      String?
  payload     Json
  status      PrintJobStatus  @default(QUEUED)
  publishedAt DateTime?
  ackedAt     DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

