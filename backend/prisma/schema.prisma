model Purchase {
  id                          String            @id @default(uuid())
  tenantId                    String?
  tenant                      Tenant?           @relation(fields: [tenantId], references: [id])
  providerName                String?
  invoiceNumber               String?
  description                 String?
  totalAmount                 Float             @default(0)
  // Datos fiscales del comprobante recibido -- para armar el archivo de
  // Compras del Libro IVA Digital (RG 4597). Todo nullable/con default:
  // una compra sin estos datos sigue funcionando igual que antes, solo
  // queda afuera del export de Libro IVA hasta que se complete.
  // Snapshot del CUIT del proveedor (aunque este vinculado a un Supplier,
  // que puede cambiar de CUIT despues) -- ver Supplier.cuit.
  providerCuit                String?
  // Codigo de tipo de comprobante AFIP (1 Factura A, 6 B, 11 C, etc; ver
  // backend/src/services/libroIvaDigital/purchaseInvoiceTypes.ts).
  invoiceType                 Int?
  invoicePointOfSale          Int?
  nonTaxedAmount              Float             @default(0)
  exemptAmount                Float             @default(0)
  ivaPerceptionAmount         Float             @default(0)
  nationalTaxPerceptionAmount Float             @default(0)
  iibbPerceptionAmount        Float             @default(0)
  municipalPerceptionAmount   Float             @default(0)
  internalTaxAmount           Float             @default(0)
  paymentMethod               PaymentMethod?
  to                          Location          @default(DEPOSITO)
  // Reemplaza `to` (enum Location fijo) - ver doc de migracion
  // "ubicaciones de stock dinamicas". Nullable en la etapa aditiva, pasa a
  // requerido una vez migrado el codigo que la escribe.
  businessLocationId          String?
  businessLocation            BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  date                        DateTime          @default(now())
  status                      PurchaseStatus    @default(COMPLETED)
  userId                      String?
  financeId                   String?           @unique
  // new: link to supplier entity and purchase order
  supplierId                  String?
  supplier                    Supplier?         @relation(fields: [supplierId], references: [id])
  purchaseOrderId             String?
  purchaseOrder               PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  user                     User?                     @relation(fields: [userId], references: [id])
  finance                  Finance?                  @relation(fields: [financeId], references: [id])
  items                    PurchaseItem[]
  stockMovements           StockMovement[]
  supplierAccountMovements SupplierAccountMovement[]

  @@index([userId])
  @@index([financeId])
  @@index([status])
  @@index([date])
  @@index([tenantId])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

model PurchaseItem {
