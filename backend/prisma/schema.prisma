  transportCuit           String?
  transportName           String?
  deliveryPricePerKm      Float?
  // devoluciones (doc: Sale con status=CANCELLED se usa como devolucion,
  // no hay modelo Return dedicado - este campo guarda el motivo/notas)
  returnReason            String?
  // promotion
  promotionId             String?
  promotionDiscount       Float?
  promotion               Promotion?        @relation(fields: [promotionId], references: [id])
  accountMovements        AccountMovement[]
  invoice                 Invoice?
  invoiceAfip             InvoiceAfip?
  remitos                 Remito[]
  businessLocation        BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  client                  Client?           @relation(fields: [clientId], references: [id])
  user                    User?             @relation(fields: [userId], references: [id])
  items                   SaleItem[]
  payments                SalePayment[]
  returns                 Return[]
  repairOrder             RepairOrder?

  @@index([quotationExpiresAt])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([stockLocationId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([invoiceStatus, nextRetryAt])
  @@index([tenantId])
  @@index([promotionId])
}

