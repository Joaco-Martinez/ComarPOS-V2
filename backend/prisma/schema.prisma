generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Multi-tenant (doc seccion 6) ===
enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model Tenant {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  isActive                  Boolean  @default(true)
  logoUrl                   String?
  logoId                    String?
  // Version rasterizada del logo para impresion termica (ESC/POS GS v 0,
  // 1bpp), generada automaticamente al subir logoUrl (ver
  // services/printbox/logoRaster.service.ts). Separada de logoUrl porque
  // el ESP32 no decodifica PNG/JPEG arbitrario, necesita el bitmap ya
  // convertido y listo para mandarle a la impresora tal cual.
  logoEscposRasterBase64    String?  @db.Text
  // Bridge HTTP viejo (POS_LOCAL_URL, ver ticket.service.ts) para imprimir
  // sin tener ningun PrintboxDevice pareado -- pensado unicamente para el
  // setup fisico on-prem de grupo-vj (unico backfill=true, ver migracion).
  // Un tenant nuevo sin PrintboxDevice pareado NO debe caer a este bridge
  // (le pegaria a la red local de grupo-vj, no a la suya): en cambio recibe
  // una notificacion invitandolo a pedir su propia PrintBox.
  legacyLocalPrinterEnabled Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // billing manual (super-admin de plataforma)
  subscriptionStatus TenantSubscriptionStatus @default(ACTIVE)
  paidUntil          DateTime?
  suspendedAt        DateTime?
  notes              String?

  // Prueba gratis self-service (ver trialSignup.service.ts): tenants creados
  // desde /trial-signup arrancan en subscriptionStatus=TRIAL con trialEndsAt
  // seteado; se bloquean solos al vencer (ver middleware/tenant.ts,
  // getTenantBlockCode) sin necesidad de un cron. Queda null para tenants
  // creados por el super-admin o el script createTenant.ts.
  trialEndsAt  DateTime?
  // Telefono de contacto de quien se dio de alta (obligatorio en
  // /trial-signup, ver trialSignup.service.ts) - lo usa el super-admin para
  // hacer seguimiento comercial/cobranza. Null para tenants creados a mano.
  contactPhone String?

  // Suscripcion self-service via Mercado Pago (ver services/billing/*.ts).
  // mpPreapprovalId es el id de la "preapproval" (suscripcion recurrente) de
  // MP asociada a este tenant - el webhook la usa para encontrar a que
  // tenant corresponde cada pago/cancelacion y pisa subscriptionStatus/
  // paidUntil solo (no reemplaza el billing manual: un tenant sin
  // mpPreapprovalId sigue gestionandose a mano desde el panel, como hasta
  // ahora). mpSubscriptionAmount queda fijo al monto pagado por primera vez
  // (precio de lanzamiento "de por vida") aunque el precio de lista suba mas
  // adelante para nuevos suscriptores.
  mpPreapprovalId      String? @unique
  mpSubscriptionAmount Float?
  // Id de uno de los PLANS en config/billing.ts ("esencial" | "profesional"
  // | "multisucursal") -- default al plan recomendado (el que era el unico
  // plan antes de tener 3), asi los tenants existentes no quedan en un
  // plan mas chico del que ya venian usando de hecho (sucursales/usuarios
  // sin limite). Determina el precio de checkout (billing.service.ts) y
  // los topes de sucursales/productos/usuarios (planLimits.service.ts).
  planId               String  @default("profesional")

  // Datos de cabecera para tickets/documentos impresos (printbox). Si son
  // null, ticket.service.ts cae a `name` para no dejar el ticket en blanco.
  ticketBusinessName String?
  ticketCuit         String?
  ticketAddress      String?
  ticketPhone        String?
  ticketEmail        String?

  // Precio de envio por km propio del negocio (ver delivery.service.ts). Si
  // es null, se usa el default global DELIVERY_PRICE_PER_KM (env var) - asi
  // que cada tenant puede pisarlo desde Configuracion > Empresa sin que haga
  // falta redeployar para cambiar un precio.
  deliveryPricePerKm Float?

  // Progreso de la guia de arranque para negocios nuevos (ver /guia en el
  // frontend y onboarding.service.ts). Mapa { [stepId]: boolean }, null hasta
  // que se marca el primer paso. Es del negocio, no de un usuario puntual:
  // cualquier empleado que entre ve el mismo progreso.
  onboardingChecklist Json?

  paymentLogs     TenantPaymentLog[]
  printboxDevices PrintboxDevice[]
  printJobs       PrintJob[]
  pushTokens      PushToken[]

  users             User[]
  clients           Client[]
  products          Product[]
  sales             Sale[]
  finances          Finance[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  invoicesAfip      InvoiceAfip[]
  remitos           Remito[]
  arcaConfigs       ArcaConfig[]
  businessLocations BusinessLocation[]
  arcaAuditLogs     ArcaAuditLog[]
  productCategories ProductCategory[]
  cbteCounters      CbteCounter[]
  // new modules
  suppliers         Supplier[]
  cashSessions      CashSession[]
  recurringExpenses RecurringExpense[]
  exchangeRates     ExchangeRate[]
  salesGoals        SalesGoal[]
  promotions        Promotion[]
  stockCounts       StockCount[]
  purchaseOrders    PurchaseOrder[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  priceLists        PriceList[]
  loyaltyAccounts   LoyaltyAccount[]
  returns           Return[]
  productStocks     ProductStock[]
  repairOrders      RepairOrder[]
}

// === Platform admin (super-admin de SaaS, fuera de cualquier tenant) ===
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentLogs TenantPaymentLog[]
}

// Espejo de los "preapproval_plan" creados del lado de Mercado Pago para
// cada plan de config/billing.ts (PLANS sigue siendo la fuente de verdad
// de precio/limites -- esta tabla solo guarda el id que devolvio MP la
// primera vez que se creo, para no duplicarlo si se vuelve a apretar el
// boton de sincronizar). planId matchea PLANS[].id ("esencial" |
// "profesional" | "multisucursal"), no es una FK -- son constantes de
// codigo, no una tabla.
model MpPreapprovalPlan {
  id        String   @id @default(uuid())
  planId    String   @unique
  mpPlanId  String   @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Override editable desde el panel de super-admin de que modulos incluye
// cada plan (PlanFeatureKey en config/billing.ts -- ya cubre TODOS los
// modulos del sistema, no solo fidelidad/promociones/cuentasCorrientes) y de
// su precio. PLANS sigue siendo la fuente de verdad default (features +
// precio) -- esta tabla solo pisa lo que un admin cambio a mano desde
// /platform-admin; sin fila para un plan, rige el default hardcodeado.
// priceArs/regularPriceArs nulos = usar el default de PLANS. Ver
// planFeatureConfig.service.ts (cachea en memoria, se invalida al escribir).
model PlanFeatureConfig {
  id              String   @id @default(uuid())
  planId          String   @unique
  features        Json
  priceArs        Float?
  regularPriceArs Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TenantPaymentLog {
  id              String                   @id @default(uuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  platformAdminId String?
  platformAdmin   PlatformAdmin?           @relation(fields: [platformAdminId], references: [id])
  previousStatus  TenantSubscriptionStatus
  newStatus       TenantSubscriptionStatus
  note            String?
  paidUntil       DateTime?
  createdAt       DateTime                 @default(now())

  @@index([tenantId])
  @@index([platformAdminId])
}

model User {
  id                   String            @id @default(uuid())
  tenantId             String?
  tenant               Tenant?           @relation(fields: [tenantId], references: [id])
  email                String
  password             String
  name                 String
  role                 Role
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  // Se pisa en cada login exitoso (ver auth.service.ts) - usado por
  // platform-admin para auditar si una cuenta se llego a usar o no.
  lastLoginAt          DateTime?
  passwordResetExpires DateTime?
  passwordResetToken   String?           @unique
  mustChangePassword   Boolean           @default(false)
  // Layout personal de accesos rapidos del mobile nav (BottomNav.tsx),
  // por usuario. null = sin personalizar, usa el orden default de
  // navConfig.ts (ver frontend/lib/quickAccess.ts#buildEffectiveNav).
  quickAccessConfig    Json?
  accountMovements     AccountMovement[]
  client               Client?
  remitos              Remito[]
  Sale                 Sale[]
  StockMovements       StockMovement[]
  purchases            Purchase[]
  // new modules
  cashSessions         CashSession[]
  stockCounts          StockCount[]
  purchaseOrders       PurchaseOrder[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  returns              Return[]
  pushTokens           PushToken[]
  repairOrders         RepairOrder[]

  @@unique([email])
  @@index([role])
  @@index([isActive])
  @@index([passwordResetToken])
  @@index([tenantId])
}

model Client {
  id                String            @id @default(uuid())
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
  nombre            String
  // Unico dato realmente obligatorio para el alta rapida (ver
  // client.registration.ts#createClient) -- pensado para poder cargar un
  // cliente al vuelo desde el buscador de POS/Servicios/Cuentas Corrientes
  // sin frenar la operacion pidiendo datos que todavia no se tienen.
  apellido          String?
  dni               String?
  telefono          String?
  gmail             String?
  category          CategoryClient    @default(Price)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userId            String?           @unique
  currentBalance    Float             @default(0)
  creditLimit       Float?
  isAccountEnabled  Boolean           @default(false)
  addressApartment  String?
  addressCity       String?
  addressFloor      String?
  addressNotes      String?
  addressNumber     String?
  addressPostalCode String?
  addressProvince   String?
  addressStreet     String?
  latitude          Float?
  longitude         Float?
  // price list
  priceListId       String?
  priceList         PriceList?        @relation(fields: [priceListId], references: [id])
  accountMovements  AccountMovement[]
  user              User?             @relation(fields: [userId], references: [id])
  remitos           Remito[]
  sales             Sale[]
  loyaltyAccount    LoyaltyAccount?
  returns           Return[]
  repairOrders      RepairOrder[]

  @@unique([tenantId, dni])
  @@unique([tenantId, gmail])
  @@index([dni])
  @@index([gmail])
  @@index([category])
  @@index([userId])
  @@index([tenantId])
  @@index([priceListId])
}

model BusinessLocation {
  id                 String               @id @default(uuid())
  tenantId           String?
  tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  name               String
  type               BusinessLocationType @default(BRANCH)
  addressStreet      String?
  addressNumber      String?
  addressCity        String?
  addressProvince    String?
  addressPostalCode  String?
  addressNotes       String?
  latitude           Float?
  longitude          Float?
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  remitos            Remito[]
  sales              Sale[]
  cashSessions       CashSession[]
  productStocks      ProductStock[]
  stockMovementsFrom StockMovement[]      @relation("StockMovementFrom")
  stockMovementsTo   StockMovement[]      @relation("StockMovementTo")
  purchases          Purchase[]
  stockLocationSales Sale[]               @relation("SaleStockLocation")
  stockCounts        StockCount[]
  repairOrders       RepairOrder[]

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
  @@index([tenantId])
}

// Stock de un producto en una ubicacion (BusinessLocation) puntual.
// Reemplaza el split fijo Product.stockLocal/stockDeposito (ver doc de
// migracion "ubicaciones de stock dinamicas") - cada tenant puede tener 0,
// 1 o N ubicaciones, no dos fijas. Se mantiene siempre una fila por cada
// combinacion producto x ubicacion existente (con 0 si no hay stock) para
// no tener que distinguir "fila ausente" de "stock en cero" en el resto
// del codigo.
model ProductStock {
  id                 String           @id @default(uuid())
  tenantId           String?
  tenant             Tenant?          @relation(fields: [tenantId], references: [id])
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessLocationId String
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  quantity           Int              @default(0)
  quantityKg         Float            @default(0)
  minQuantity        Int?
  minQuantityKg      Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([productId, businessLocationId])
  @@index([productId])
  @@index([businessLocationId])
  @@index([tenantId])
}

model ProductCategory {
  id          String    @id @default(uuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@index([tenantId])
}

model Product {
  id                  String              @id @default(uuid())
  tenantId            String?
  tenant              Tenant?             @relation(fields: [tenantId], references: [id])
  name                String
  description         String?
  type                ProductType         @default(SIMPLE)
  price               Float
  wholesalePrice      Float
  clientPrice         Float
  minStock            Int?
  stockLocal          Int                 @default(0)
  stockDeposito       Int                 @default(0)
  categoryId          String?
  imageUrl            String?
  imageId             String?
  isActive            Boolean             @default(true)
  sku                 String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  saleUnit            SaleUnit            @default(UNIT)
  pricePerKg          Float?
  wholesalePricePerKg Float?
  clientPricePerKg    Float?
  stockLocalKg        Float               @default(0)
  stockDepositoKg     Float               @default(0)
  minStockKg          Float?              @default(0)
  purchasePrice       Float               @default(0)
  ivaRate             Float               @default(21)
  isService           Boolean             @default(false)
  minStockDeposito    Int?
  minStockDepositoKg  Float?
  alerts              Alert[]
  BoxContent          BoxContent[]
  category            ProductCategory?    @relation(fields: [categoryId], references: [id])
  usedIn              ProductComponent[]  @relation("ComponentProduct")
  components          ProductComponent[]  @relation("CompositeProduct")
  stats               ProductStats[]
  remitoItems         RemitoItem[]
  SaleItem            SaleItem[]
  StockMovement       StockMovement[]
  purchaseItems       PurchaseItem[]
  // new modules
  stockCountItems     StockCountItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  priceListItems      PriceListItem[]
  returnItems         ReturnItem[]
  stock               ProductStock[]
  repairOrderItems    RepairOrderItem[]

  @@unique([tenantId, sku])
  @@index([sku])
  @@index([categoryId])
  @@index([type])
  @@index([isActive])
  @@index([isActive, name])
  @@index([tenantId])
}

model ProductComponent {
  id          String   @id @default(uuid())
  compositeId String
  componentId String
  quantity    Int?
  quantityKg  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  component   Product  @relation("ComponentProduct", fields: [componentId], references: [id])
  composite   Product  @relation("CompositeProduct", fields: [compositeId], references: [id], onDelete: Cascade)

  @@unique([compositeId, componentId])
  @@index([componentId])
}

model ArcaConfig {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  businessName       String
  cuit               String
  ivaCondition       String?
  environment        ArcaEnvironment   @default(HOMOLOGACION)
  status             ArcaConfigStatus  @default(INACTIVE)
  certEncrypted      String?
  keyEncrypted       String?
  certExpiresAt      DateTime?
  lastTokenAt        DateTime?
  lastCheckAt        DateTime?
  lastError          String?
  isActive           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  activityStart      DateTime?
  certAlias          String?
  defaultConcept     Int               @default(1)
  defaultCurrencyId  String            @default("PES")
  defaultPointOfSale Int?
  fiscalAddress      String?
  iibb               String?
  lastSuccessAt      DateTime?
  scope              String            @unique @default("GRUPO_VJ")
  csrEncrypted       String?
  csrGeneratedAt     DateTime?
  tokens             AfipToken[]
  auditLogs          ArcaAuditLog[]
  pointsOfSale       ArcaPointOfSale[]
  remitos            Remito[]
  remitoCais         RemitoCaiConfig[]

  @@index([cuit])
  @@index([isActive])
  @@index([environment])
  @@index([status])
  @@index([tenantId])
}

model AfipToken {
  id             String     @id @default(uuid())
  arcaConfigId   String
  expiration     DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  service        String     @default("wsfe")
  signEncrypted  String
  tokenEncrypted String
  arcaConfig     ArcaConfig @relation(fields: [arcaConfigId], references: [id], onDelete: Cascade)

  @@unique([arcaConfigId, service])
  @@index([expiration])
}

model ArcaPointOfSale {
  id               String     @id @default(uuid())
  arcaConfigId     String
  number           Int
  description      String?
  enabled          Boolean    @default(true)
  isDefault        Boolean    @default(false)
  enabledCbteTypes Int[]      @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  arcaConfig       ArcaConfig @relation(fields: [arcaConfigId], references: [id], onDelete: Cascade)

  @@unique([arcaConfigId, number])
  @@index([number])
  @@index([enabled])
}

model RemitoCaiConfig {
  id           String     @id @default(uuid())
  arcaConfigId String
  mode         RemitoMode @default(PREPRINTED_FORM)
  pointOfSale  Int
  cai          String
  expiresAt    DateTime
  rangeFrom    Int?
  rangeTo      Int?
  nextNumber   Int?
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  remitos      Remito[]
  arcaConfig   ArcaConfig @relation(fields: [arcaConfigId], references: [id], onDelete: Cascade)

  @@index([pointOfSale])
  @@index([enabled])
  @@index([expiresAt])
}

model Remito {
  id                    String            @id @default(uuid())
  tenantId              String?
  tenant                Tenant?           @relation(fields: [tenantId], references: [id])
  saleId                String?
  clientId              String?
  userId                String?
  businessLocationId    String?
  arcaConfigId          String?
  remitoCaiConfigId     String?
  status                RemitoStatus      @default(ISSUED)
  mode                  RemitoMode        @default(DIGITAL_FULL)
  pointOfSale           Int
  number                Int
  fullNumber            String            @unique
  code                  String            @default("91")
  issueDate             DateTime          @default(now())
  placeOfIssue          String?
  cai                   String?
  caiExpiresAt          DateTime?
  caiRangeFrom          Int?
  caiRangeTo            Int?
  businessName          String?
  businessCuit          String?
  businessIvaCondition  String?
  businessIibb          String?
  businessActivityStart DateTime?
  businessFiscalAddress String?
  businessAddress       String?
  businessEmail         String?
  businessPhone         String?
  clientName            String?
  clientDni             String?
  clientCuit            String?
  clientIvaCondition    String?
  clientAddress         String?
  clientLocality        String?
  sellerName            String?
  saleCondition         String?
  transportName         String?
  transportCuit         String?
  packagesCount         Int?
  declaredValue         Float?
  observations          String?
  pdfUrl                String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  arcaConfig            ArcaConfig?       @relation(fields: [arcaConfigId], references: [id])
  businessLocation      BusinessLocation? @relation(fields: [businessLocationId], references: [id])
  client                Client?           @relation(fields: [clientId], references: [id])
  remitoCaiConfig       RemitoCaiConfig?  @relation(fields: [remitoCaiConfigId], references: [id])
  sale                  Sale?             @relation(fields: [saleId], references: [id])
  user                  User?             @relation(fields: [userId], references: [id])
  items                 RemitoItem[]

  @@unique([pointOfSale, number])
  @@index([saleId])
  @@index([clientId])
  @@index([userId])
  @@index([businessLocationId])
  @@index([arcaConfigId])
  @@index([remitoCaiConfigId])
  @@index([status])
  @@index([issueDate])
  @@index([tenantId])
}

model RemitoItem {
  id          String   @id @default(uuid())
  remitoId    String
  productId   String?
  code        String?
  description String
  quantity    Int?
  quantityKg  Float?
  saleUnit    SaleUnit @default(UNIT)
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
  remito      Remito   @relation(fields: [remitoId], references: [id], onDelete: Cascade)

  @@index([remitoId])
  @@index([productId])
}

model ArcaAuditLog {
  id           String          @id @default(uuid())
  tenantId     String?
  tenant       Tenant?         @relation(fields: [tenantId], references: [id])
  arcaConfigId String?
  userId       String?
  action       ArcaAuditAction
  detail       String?
  ip           String?
  createdAt    DateTime        @default(now())
  arcaConfig   ArcaConfig?     @relation(fields: [arcaConfigId], references: [id])

  @@index([arcaConfigId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId])
}

model CbteCounter {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  ptoVta     Int
  cbteTipo   Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, ptoVta, cbteTipo])
  @@index([tenantId])
}

model InvoiceAfip {
  id                   String        @id @default(uuid())
  tenantId             String?
  tenant               Tenant?       @relation(fields: [tenantId], references: [id])
  saleId               String?       @unique
  relatedInvoiceId     String?
  cuit                 String
  puntoVenta           Int
  tipoComprobante      Int
  tipoDoc              Int
  nroDoc               BigInt
  numero               Int
  fechaEmision         DateTime
  resultado            String
  cae                  String?
  caeVto               DateTime?
  total                Float
  neto                 Float
  iva                  Float
  condicionIVAReceptor Int
  moneda               String        @default("PES")
  urlQR                String?
  qrBase64             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  relatedInvoice       InvoiceAfip?  @relation("CreditNoteRelation", fields: [relatedInvoiceId], references: [id])
  creditNotes          InvoiceAfip[] @relation("CreditNoteRelation")
  sale                 Sale?         @relation(fields: [saleId], references: [id])

  @@unique([puntoVenta, tipoComprobante, numero])
  @@index([cuit, puntoVenta, tipoComprobante])
  @@index([tenantId])
}

model Sale {
  id                      String            @id @default(uuid())
  tenantId                String?
  tenant                  Tenant?           @relation(fields: [tenantId], references: [id])
  userId                  String?
  clientId                String?
  gmailSend               String?
  subtotal                Float             @default(0)
  total                   Float             @default(0)
  discountType            DiscountType?
  discountValue           Float?
  isInvoiced              Boolean           @default(false)
  isNoteCredit            Boolean           @default(false)
  invoiceStatus           InvoiceStatus     @default(NONE)
  afipLastError           String?
  nextRetryAt             DateTime?
  retryCount              Int               @default(0)
  afipPayloadJson         Json?
  paymentMethod           PaymentMethod
  receiptType             ReceiptType
  status                  SaleStatus        @default(PENDING)
  isAccountSale           Boolean           @default(false)
  accountDebtAmount       Float             @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  pdfUrl                  String?
  stockLocation           Location          @default(LOCAL)
  // Reemplaza stockLocation (enum Location fijo) - de que ubicacion se
  // descuenta el stock de esta venta. Distinto de businessLocationId (esa
  // es metadata de en que sucursal se hizo la venta, no se toca). Ver doc
  // de migracion "ubicaciones de stock dinamicas". Nullable en la etapa
  // aditiva, pasa a requerido una vez migrado el codigo que la escribe.
  stockLocationId         String?
  stockLocationRef        BusinessLocation? @relation("SaleStockLocation", fields: [stockLocationId], references: [id])
  quotationExpiredAt      DateTime?
  quotationExpiresAt      DateTime?
  quotationPdfUrl         String?
  grossProfit             Float             @default(0)
  businessLocationId      String?
  declaredValue           Float?
  deliveryAddressSnapshot String?
  deliveryCost            Float             @default(0)
  deliveryDistanceKm      Float?
