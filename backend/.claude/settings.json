{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm start)",
      "Bash(npm run seed)",
      "Bash(npm run reset)",
      "Bash(npm run worker)",
      "Bash(npm run prisma:studio)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate deploy)",
      "Bash(npx prisma migrate status)",
      "Bash(npx prisma studio)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(rm *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
