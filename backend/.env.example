# Copiar a .env y completar con valores reales. NUNCA commitear .env real.

# --- ARCA / AFIP ---
ARCA_CONFIG_SECRET="CHANGE_ME_min_32_chars"
ARCA_CREDENTIALS_SECRET="CHANGE_ME_min_32_chars"
ARCA_DEFAULT_SERVICE="wsfe"
ARCA_OPENSSL_PATH="openssl"
ARCA_WSAA_HOMO_URL="https://wsaahomo.afip.gov.ar/ws/services/LoginCms"
ARCA_WSAA_PROD_URL="https://wsaa.afip.gov.ar/ws/services/LoginCms"
ARCA_WSFE_HOMO_URL="https://wswhomo.afip.gov.ar/wsfev1/service.asmx"
ARCA_WSFE_PROD_URL="https://servicios1.afip.gov.ar/wsfev1/service.asmx"

# --- Datos del negocio (no secretos, pero configurables por tenant a futuro) ---
BUSINESS_ADDRESS="CHANGE_ME"
BUSINESS_CUIT="CHANGE_ME"
BUSINESS_NAME="CHANGE_ME"
BUSINESS_PHONE="CHANGE_ME"
BUSINESS_SUBTITLE="CHANGE_ME"

# --- Cloudinary ---
CLOUDINARY_API_KEY="CHANGE_ME"
CLOUDINARY_API_SECRET="CHANGE_ME"
CLOUDINARY_CLOUD_NAME="CHANGE_ME"

# --- Cookies / CORS ---
COOKIE_DOMAIN="CHANGE_ME"
FRONTEND_URL="http://localhost:3000/login"
STOREFRONT_URL=""
ADMIN_FRONTEND_URL=""
CORS_ORIGINS=""

# --- Base de datos ---
DATABASE_URL="postgresql://user:password@host:port/dbname"

# --- Negocio / delivery ---
DEFAULT_QUOTATION_HOURS="36"
DELIVERY_PRICE_PER_KM="8000"
EXPIRE_QUOTATIONS_LIMIT="100"
DELIVERY_FALLBACK_MULTIPLIER="1.4"

# --- Mail ---
GMAIL_PASS="CHANGE_ME"
GMAIL_USER="CHANGE_ME"

# --- Multi-tenant (doc seccion 6) ---
# Slug del tenant usado cuando no se puede resolver uno por subdominio
# (localhost, IPs, dominio sin subdominio). Hoy es el unico tenant real.
DEFAULT_TENANT_SLUG="grupo-vj"

# --- Entorno ---
IS_PROD="false"
NODE_ENV="development"
PORT="5000"

# --- Impresion local POS (legacy, bridge HTTP - fallback si el tenant no tiene printbox) ---
POS_LOCAL_TOKEN="CHANGE_ME_token_largo"
POS_LOCAL_URL="https://pos-local.example.com"

# --- PrintBox (ESP32 + MQTT, ver printbox/README.md) ---
# URL publica de este backend (para armar links absolutos que el ESP32
# pueda pedir directamente, ej. el logo rasterizado del tenant).
API_PUBLIC_URL="https://api.comarpos.com.ar"
# Opcional: sin estas 3 variables, printbox queda apagado y todo tenant usa
# el bridge POS_LOCAL_* de arriba (no rompe nada existente).
MQTT_URL="mqtts://printbox-broker.example.com:8883"
# URL que el ESP32 debe usar para conectarse (puede diferir de MQTT_URL si el
# backend le pega al broker por red interna pero el device entra por internet).
MQTT_PUBLIC_URL="mqtts://printbox-broker.example.com:8883"
MQTT_ADMIN_USERNAME="CHANGE_ME"
MQTT_ADMIN_PASSWORD="CHANGE_ME"
# Encripta el password MQTT de cada tenant en Tenant.printboxMqttPasswordEncrypted
PRINTBOX_CREDENTIALS_SECRET="CHANGE_ME_min_32_chars"

# --- JWT (minimo 64 caracteres, generar con: openssl rand -hex 32) ---
JWT_SECRET="CHANGE_ME_minimo_64_caracteres_aleatorios"

# --- Ruteo de delivery (OSRM, gratis y sin API key) ---
# Opcional: por default usa el demo publico de project-osrm.org. Si el
# volumen de envios crece, se puede levantar un servidor OSRM propio y
# apuntar OSRM_BASE_URL ahi.
# OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_TIMEOUT_MS="8000"

# --- Monitoreo de errores (Sentry, opcional) ---
# Sin SENTRY_DSN, este modulo no hace nada. Para activarlo: cuenta gratis en
# sentry.io, crear un proyecto Node/Express, pegar el DSN aca.
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
