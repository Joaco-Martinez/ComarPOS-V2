{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start:cron": "node dist/cron/index.js",
    "reset": "ts-node src/reset.ts",
    "seed": "ts-node src/seed.ts",
    "seed:full": "ts-node src/seed-full.ts",
    "tenant:create": "ts-node src/scripts/createTenant.ts",
    "afip:renew": "ts-node src/cron/afipRenovador.ts",
    "expire:quotations": "ts-node src/jobs/expirePendingQuotations.ts",
    "expire:quotations:prod": "node dist/jobs/expirePendingQuotations.js",
    "worker": "ts-node src/worker.ts",
    "cron:recurring": "ts-node -e \"require('./src/services/recurringExpense.service').recurringExpenseService.processDueNow().then(r=>console.log(r)).finally(()=>process.exit(0))\"",
    "cron:low-stock": "ts-node -e \"require('./src/services/notification.service').notificationService.checkLowStock().then(r=>console.log(r)).finally(()=>process.exit(0))\"",
    "cron:expire-loyalty": "ts-node -e \"require('./src/services/loyalty.service').loyaltyService.expireOldPoints().then(r=>console.log(r)).finally(()=>process.exit(0))\"",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "prisma:studio": "npx prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "backup": "ts-node scripts/backupDb.ts",
    "backup:pg_dump": "bash scripts/backup-db.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@sentry/node": "^10.68.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.6",
    "pdf-to-printer": "^5.6.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.2",
    "@types/qrcode": "^1.5.6",
    "@types/streamifier": "^0.1.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
